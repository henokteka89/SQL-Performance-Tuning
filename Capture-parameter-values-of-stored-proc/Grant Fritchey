-- Drop the session if it already exists
IF EXISTS (SELECT * FROM sys.server_event_sessions WHERE name = 'StoredProcedureParameterValues')
    DROP EVENT SESSION StoredProcedureParameterValues ON SERVER;

-- Create the Extended Event session
CREATE EVENT SESSION StoredProcedureParameterValues
ON SERVER
ADD EVENT sqlserver.rpc_completed(
    ACTION (sqlserver.database_id, sqlserver.username, sqlserver.client_hostname)
    WHERE (sqlserver.database_id = 7)), -- Replace with AdventureWorks database_id
ADD EVENT sqlserver.sql_batch_completed(
    ACTION (sqlserver.database_id, sqlserver.username, sqlserver.client_hostname)
    WHERE (sqlserver.database_id = 7)), -- Replace with AdventureWorks database_id
ADD EVENT sqlserver.sp_statement_completed(
    ACTION (sqlserver.database_id, sqlserver.username, sqlserver.client_hostname)
    WHERE (sqlserver.database_id = 7)), -- Replace with AdventureWorks database_id
ADD EVENT sqlserver.sql_batch_starting(
    ACTION (sqlserver.database_id, sqlserver.username, sqlserver.client_hostname)
    WHERE (sqlserver.database_id = 7)), -- Replace with AdventureWorks database_id
ADD EVENT sqlserver.rpc_starting(
    ACTION (sqlserver.database_id, sqlserver.username, sqlserver.client_hostname)
    WHERE (sqlserver.database_id = 7)), -- Replace with AdventureWorks database_id
ADD EVENT sqlserver.sp_statement_starting(
    ACTION (sqlserver.database_id, sqlserver.username, sqlserver.client_hostname)
    WHERE (sqlserver.database_id = 7)) -- Replace with AdventureWorks database_id
ADD TARGET package0.asynchronous_file_target
    (SET filename = 'C:\temp\StoredProcedureParameterValues.xel');
GO
